#!/bin/sh
# pre-commit: 문서화된 footgun 가드 (CLAUDE.md 주의사항 기반)
#   1) 음수 letterSpacing → 한글 자간 깨짐 (WARN, 차단 안 함 — 큰 숫자 표시 등 의도적 경우 존재)
#   2) baseUrl http:// → Android 9+ cleartext 차단으로 앱 깨짐 (BLOCK)
# 활성화: git config core.hooksPath .githooks

staged_dart=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.dart$')
fail=0

if [ -n "$staged_dart" ]; then
  # 1) 음수 letterSpacing (WARN)
  neg=$(echo "$staged_dart" | xargs grep -nE 'letterSpacing:[[:space:]]*-[0-9]' 2>/dev/null)
  if [ -n "$neg" ]; then
    echo "[pre-commit][WARN] 음수 letterSpacing 발견 (한글 자간 깨짐 주의 — 의도면 무시):"
    echo "$neg"
  fi

  # 2) baseUrl http:// (BLOCK)
  badurl=$(echo "$staged_dart" | xargs grep -nE 'baseUrl.*http://' 2>/dev/null)
  if [ -n "$badurl" ]; then
    echo "[pre-commit][ERROR] baseUrl http:// 금지 (Android 9+ cleartext 차단). HTTPS 사용:"
    echo "$badurl"
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "[pre-commit] 차단됨 — 위 ERROR 수정 후 재커밋 (긴급 우회: git commit --no-verify)."
  exit 1
fi
exit 0

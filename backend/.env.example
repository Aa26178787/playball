# PlayBall backend 환경변수 예시 — 실제 값은 systemd drop-in
# (/etc/systemd/system/playball.service.d/email.conf) 또는 셸 export 로 주입.
# 절대 실제 값을 커밋하지 말 것 (.env* 는 .gitignore).

# DB (PgBouncer 6432 경유). 미설정 시 connection.py fallback 사용.
DB_PASSWORD=change_me
DB_POOL_MAX=20

# 관리자 엔드포인트 (stadiums / prediction admin) — X-Admin-Key 헤더로 검증
ADMIN_KEY=change_me_strong_random
ADMIN_EMAIL=admin@example.com

# 메일 (인증코드/비번재설정) — Gmail 앱 비밀번호
EMAIL_USER=noreply.example@gmail.com
EMAIL_PASS=app_password_here
ALLOW_DEV_VERIFICATION_CODES=0

# Paths / public links (defaults shown)
STATIC_DIR=/home/ubuntu/playball/backend/static
PUBLIC_BASE_URL=https://playball.duckdns.org
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=90

# 외부 API
OPENWEATHER_API_KEY=your_key
KAKAO_REST_KEY=your_kakao_rest_key
